# ==============================================================================
# SCM Autonomous Disruption Response Engine - Configuration Template
# ==============================================================================

# LLM Providers (Optional for local deterministic runs; required for full natural language explainer)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ROUTING_PREFERENCE=gemini

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=scm-disruption-response

# Database Storage Configuration
# Set to 'true' for local zero-configuration SQLite sandbox; 'false' for MySQL Server
USE_SQLITE=true
SQLITE_PATH=local_orders.db

# MySQL Server Configuration (Ignored if USE_SQLITE=true)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=scm_agentic_db

# Human-in-the-Loop (HITL) Policy Threshold
# Plans with total recovery investment exceeding this threshold require dispatcher authorization
HITL_APPROVAL_THRESHOLD_USD=5000.0

# Solver Configuration
SOLVER_TIMEOUT_SEC=10
MAX_CRITIC_RETRIES=2
