# ==========================================
# SCM AGENTIC WORKFLOW ENVIRONMENT CONFIG
# ==========================================

# -----------------
# LLM API KEYS
# -----------------
# Google Gemini API Key (Recommended for multi-agent reasoning & Executive reports)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourActualKeyGoesHere..."

# Groq API Key (High-speed Llama 3.3 agent routing & text analysis)
# Get your key at: https://console.groq.com/
GROQ_API_KEY="gsk_YourActualGroqKeyGoesHere..."

# Preferred AI Routing Engine: "gemini" or "groq"
ROUTING_PREFERENCE="gemini"

# -----------------
# DATABASE CONFIGURATION
# -----------------
# Storage mode: "true" for zero-config SQLite Sandbox, "false" for MySQL Server
USE_SQLITE="true"

# MySQL Configuration (Only required if USE_SQLITE="false")
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="scm_agentic_db"

