# LLM Providers (Optional for local deterministic runs; required for live Explainer briefings)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# LangSmith Tracing & Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=supply-chain-control-tower

# Multi-Echelon Network Planning Parameters
DEFAULT_PLANNING_PERIODS=4
MAX_NEGOTIATION_ROUNDS=2
SOLVER_TIMEOUT_SEC=10
