# ==============================================================================
# Indian Supply Chain Resilience Agent - Environment Configuration
# ==============================================================================

# LLM Providers (Optional for local deterministic runs; activates live Cloud API when set)
# - Google Gemini 2.5 Flash: Used for Risk Assessment & Explainer Briefing
GEMINI_API_KEY=your_gemini_api_key_here

# - Groq LPU (Llama 3.3 70B): Used for low-latency constraint validation
GROQ_API_KEY=your_groq_api_key_here

# Observability (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=indian-supply-chain-resilience

# Server Settings
API_PORT=8000
STREAMLIT_PORT=8501
